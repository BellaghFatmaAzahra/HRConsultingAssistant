      "id": "8ee8aff4-d317-42e5-a85f-ab73320da517",
      "name": "Load Documents (run once)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fictional sample documents (no real data). Replace or extend with your own public documents.\nconst docs = [\n  {\n    source: 'Remote Work Policy (fictional)',\n    text: 'Employees of Northwind Consulting may work remotely up to three days per week. A remote work day must be agreed with the team lead at least one working day in advance. Core collaboration hours are 10:00 to 15:00 local time. Equipment for a home office is provided up to 400 EUR once every two years.'\n  },\n  {\n    source: 'Leave Policy (fictional)',\n    text: 'Full-time employees receive 25 days of paid annual leave per calendar year. Up to 5 unused days may be carried over until 31 March of the following year. A medical certificate is required for sick leave longer than three consecutive days. Leave requests are submitted in the HR portal at least two weeks ahead for periods longer than five days.'\n  },\n  {\n    source: 'Parental Leave Guide (fictional)',\n    text: 'Parents may take up to 16 weeks of paid parental leave within the first 12 months after the birth or adoption of a child. The leave can be split into at most two blocks. Employees must notify HR in writing at least eight weeks before the planned start date.'\n  },\n  {\n    source: 'Code of Conduct and Grievance Procedure (fictional)',\n    text: 'All employees are expected to treat colleagues and clients with respect. Concerns can be raised confidentially with the HR team or with the independent ombudsperson. HR acknowledges every grievance within three working days and aims to close the case within 30 days. Retaliation against anyone raising a concern in good faith is prohibited.'\n  },\n  {\n    source: 'Learning and Development Budget (fictional)',\n    text: 'Each employee has an annual learning budget of 1,500 EUR and five paid training days. Courses must be approved by the line manager before booking. Conference travel is covered under the same budget.'\n  }\n];\nreturn docs.map(d => ({ json: d }));"
      },
      "id": "25c16124-4edf-4d36-a00d-938e01b9d759",
      "name": "Fictional HR Documents",
      "type": "n8n-nodes-base.code",
