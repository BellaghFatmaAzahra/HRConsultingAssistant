    {
      "parameters": {
        "public": true,
        "initialMessages": "Ask an HR consulting question. Answers come only from the document library and always cite their source.",
        "options": {
          "loadPreviousSession": "notSupported",
          "responseMode": "responseNodes"
        }
      },
      "id": "cc43957b-5d37-43d8-a4fe-8520f4617fbc",
      "name": "Consultant Question",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
      "position": [
        0,
        320
      ],
      "webhookId": "889076f3-1a90-4b3b-9432-9e8ca1e96650"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = String($input.item.json.chatInput || '');\nconst sessionId = $input.item.json.sessionId || '';\n\n// 1) Mask e-mail addresses\nlet masked = original.replace(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/g, '[EMAIL]');\n\n// 2) Mask phone numbers (digit groups with at least 8 digits)\nmasked = masked.replace(/\\+?\\d[\\d\\s().-]{6,}\\d/g, function (m) {\n  const digits = m.replace(/\\D/g, '');\n  return digits.length >= 8 ? '[PHONE]' : m;\n});\n\n// 3) Flag sensitive questions (computed on the original text, never sent to the model)\nconst reasons = [];\nconst lower = original.toLowerCase();\nconst healthRe = /(health|medical|illness|sick|disabilit|pregnan|diagnos|therapy|mental|burnout|injur|cancer|surgery)/;\nconst rightsRe = /(rights|discriminat|harass|dismiss|terminat|fired|lawsuit|legal action|union|whistleblow|grievance|disciplin|retaliat)/;\nif (healthRe.test(lower)) reasons.push('health');\nif (rightsRe.test(lower)) reasons.push('personal rights');\nconst namedRe = /\\b(Mr|Mrs|Ms|Miss|Dr|Herr|Frau|Mme)\\.?\\s+[A-Z][a-z]+|\\b(employee|colleague|candidate|consultant|manager|client)\\s+(named\\s+)?[A-Z][a-z]+\\s+[A-Z][a-z]+/;\nif (masked !== original || namedRe.test(original)) reasons.push('named individual');\n\nreturn {\n  json: {\n    sessionId: sessionId,\n    maskedQuestion: masked,\n    sensitive: reasons.length > 0,\n    sensitiveReasons: reasons.join(', ')\n  }\n};"
      },
      "id": "08d8f8cd-b25c-4905-aa61-c90677ec3964",
      "name": "Mask Personal Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        448
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.maskedQuestion }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an internal HR consulting assistant. You answer ONLY from the passages returned by the tool search_hr_documents.\n\nRules:\n1. Always call search_hr_documents before answering.\n2. Use only facts found in the retrieved passages. Never use outside knowledge and never guess.\n3. Cite the source document name (metadata.source) of every passage you used, in the sources field, and mention it in the answer text, e.g. \"(Source: Leave Policy (fictional))\".\n4. If no retrieved passage is relevant to the question, set answer to \"I don't know\" and sources to an empty list.\n5. The question may contain placeholders such as [EMAIL] or [PHONE] for masked personal data. Never try to reconstruct them."
        }
      },
